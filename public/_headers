/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' https: data: blob:; media-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/admin/*
  Cache-Control: no-store
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), geolocation=()
/merchant/*
  Cache-Control: no-store
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), geolocation=()
/report/*
  Cache-Control: no-store
/v/*
  Cache-Control: no-cache
/stores/*
  Cache-Control: no-cache
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), geolocation=()

/scan/*
  Cache-Control: no-cache
  ! Permissions-Policy
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
/print/*
  Cache-Control: no-store
/map/*
  Cache-Control: no-cache
/seller/*
  Cache-Control: no-cache
/site/*
  Cache-Control: no-cache
